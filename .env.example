# Leave all three empty to run the local demo (no sign-in, edits saved in .data/).
# Set them (in Vercel, or .env.local) to turn on Google sign-in and the shared database.

# Public by design. Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit it. Mark it Sensitive in Vercel.
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_…).
SUPABASE_SECRET_KEY=

# Optional. "true" lets anyone view the synthetic demo without signing in. Visitors' edits go to a
# separate sandbox, and they can't manage access. Remove it (and redeploy) to require sign-in again.
PUBLIC_DEMO=
